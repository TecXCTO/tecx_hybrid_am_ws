<mujoco model="aerospace_additive_manufacturing_cell">
    <compiler coordinate="local" inertiafromgeom="true"/>
    <option timestep="0.001" gravity="0 0 -9.81"/> <!-- 1kHz Internal Physics Sync -->

    <asset>
        <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3" rgb2=".2 .3 .4" width="512" height="512"/>
        <material name="grid_mat" texture="grid" texrepeat="1 1"/>
    </asset>

    <worldbody>
        <geom name="floor" type="plane" size="0 0 .25" material="grid_mat"/>
        <light directional="false" diffuse=".8 .8 .8" pos="0 0 4" dir="0 0 -1"/>

        <!-- Real-time Inspected Printing Substrate Table -->
        <body name="print_bed" pos="0.6 0 0.05">
            <geom name="substrate_plate" type="box" size="0.3 0.3 0.02" rgba="0.2 0.2 0.2 1"/>
            <!-- Sensor Site located precisely beneath the build zone for tracking structural variance -->
            <site name="bed_sensor_zone" pos="0 0 0.021" size="0.05 0.001" rgba="0 1 0 0.5"/>
        </body>

        <!-- 6-DOF Spatial Robot Base -->
        <body name="base_link" pos="0 0 0.1">
            <geom name="base_geom" type="cylinder" size="0.15 0.1" rgba="0.4 0.4 0.4 1"/>
            
            <body name="link1" pos="0 0 0.1">
                <joint name="joint1" type="hinge" axis="0 0 1" range="-180 180"/>
                <geom type="capsule" fromto="0 0 0 0 0 0.3" size="0.05" rgba="0.1 0.2 0.7 1"/>
                
                <body name="link2" pos="0 0 0.3">
                    <joint name="joint2" type="hinge" axis="0 1 0" range="-90 90"/>
                    <geom type="capsule" fromto="0 0 0 0 0 0.35" size="0.045" rgba="0.2 0.5 0.2 1"/>
                    
                    <body name="link3" pos="0 0 0.35">
                        <joint name="joint3" type="hinge" axis="0 1 0" range="-120 120"/>
                        <geom type="capsule" fromto="0 0 0 0 0 0.3" size="0.04" rgba="0.7 0.1 0.1 1"/>
                        
                        <body name="link4" pos="0 0 0.3">
                            <joint name="joint4" type="hinge" axis="0 0 1" range="-150 150"/>
                            <geom type="capsule" fromto="0 0 0 0 0 0.2" size="0.035" rgba="0.6 0.6 0.1 1"/>
                            
                            <body name="link5" pos="0 0 0.2">
                                <joint name="joint5" type="hinge" axis="0 1 0" range="-100 100"/>
                                <geom type="capsule" fromto="0 0 0 0 0 0.15" size="0.03" rgba="0.1 0.6 0.6 1"/>
                                
                                <body name="link6" pos="0 0 0.15">
                                    <joint name="joint6" type="hinge" axis="0 0 1" range="-180 180"/>
                                    
                                    <!-- High-Value Deposition Toolhead + Real-Time NPU Inspection Sensor Frame -->
                                    <body name="toolhead" pos="0 0 0.05">
                                        <geom name="head_body" type="box" size="0.04 0.04 0.05" rgba="0.3 0.3 0.3 1"/>
                                        <geom name="laser_nozzle" type="cone" pos="0 0 -0.06" size="0.01 0.015" rgba="0.8 0.5 0.1 1"/>
                                        <!-- Co-axial optical defect detection visual tracking mount -->
                                        <site name="inspection_focus" pos="0 0 -0.07" size="0.003" rgba="1 0 0 1"/>
                                    </body>
                                </body>
                            </body>
                        </body>
                    </tbody>
                </body>
            </body>
        </body>
    </worldbody>

    <!-- 1kHz Low-Latency Position Target Control Registers -->
    <actuator>
        <position name="servo1" joint="joint1" kp="1500" ctrlrange="-3.14 3.14"/>
        <position name="servo2" joint="joint2" kp="2000" ctrlrange="-1.57 1.57"/>
        <position name="servo3" joint="joint3" kp="1200" ctrlrange="-2.09 2.09"/>
        <position name="servo4" joint="joint4" kp="800"  ctrlrange="-2.61 2.61"/>
        <position name="servo5" joint="joint5" kp="600"  ctrlrange="-1.74 1.74"/>
        <position name="servo6" joint="joint6" kp="400"  ctrlrange="-3.14 3.14"/>
    </actuator>
</mujoco>
